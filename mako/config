# Catppuccin Mocha: matches waybar, hyprlock and the Hyprland borders
# See `man 5 mako` for all options

font=JetBrainsMono Nerd Font 11
width=360
max-visible=5
sort=-time

margin=8
padding=12
border-size=2
border-radius=6
icons=1
max-icon-size=40

background-color=#1e1e2e
text-color=#cdd6f4
border-color=#fab387ee
progress-color=over #f38ba8

# Hide popups after 5 seconds, even if the app asks for longer
default-timeout=5000
ignore-timeout=1

[urgency=low]
border-color=#6c7086aa

# Critical alerts (e.g. low battery) stay until dismissed
[urgency=critical]
border-color=#f38ba8ee
default-timeout=0
